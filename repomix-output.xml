        DataSource = _cache.GetOrAdd(TenantCacheKey.TenantsCacheKey,
            () => _context.Tenants.OrderBy(x => x.Name)
                .ProjectTo<TenantDto>(_mapper.ConfigurationProvider)
                .ToList(),
