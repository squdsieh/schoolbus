            <MudText>@L["have an account?"] <MudLink Href="/pages/authentication/login">@L["Sign In"]</MudLink></MudText>

            <MudTextField T="string"
                          Immediate="true"
                          Label="@L["User Name"]"
                          @bind-Value="_model.UserName"
                          For="@(() => _model.UserName)"
